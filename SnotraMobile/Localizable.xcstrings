    "Allowed on your desktop" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Desktop erlaubt"
          }
        }
      }
    },
    "Allowed once from your phone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal erlaubt, vom Handy aus"
          }
        }
      }
    },
    "Allowing from your phone needs Face ID or your passcode. Set a passcode in the iPhone's settings, or answer on your desktop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Erlauben vom Handy aus braucht es Face ID oder deinen Code. Richte in den iPhone-Einstellungen einen Code ein oder antworte auf deinem Desktop."
          }
        }
      }
    },
    "Answer it on your desktop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworte sie auf deinem Desktop."
          }
        }
      }
    },
    "Apple couldn't confirm that this copy of the app is genuine. Try again later, or install the app again from TestFlight or the App Store." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple konnte nicht bestätigen, dass diese Kopie der App echt ist. Versuch es später noch einmal oder installiere die App neu über TestFlight oder den App Store."
          }
        }
      }
    },
    "Ask something. Snotra on your desktop answers in this workspace." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag etwas. Snotra auf deinem Desktop antwortet in diesem Workspace."
          }
        }
      }
    },
