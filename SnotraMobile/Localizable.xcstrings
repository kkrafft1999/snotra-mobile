          }
        }
      }
    },
    "Snotra shows nothing while the screen is recorded, mirrored or shared." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snotra zeigt nichts an, solange der Bildschirm aufgenommen, gespiegelt oder geteilt wird."
          }
        }
