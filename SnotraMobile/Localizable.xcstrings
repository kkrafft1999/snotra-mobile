    "A command changed a knowledge file" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Befehl hat eine Wissensdatei geändert"
          }
        }
      }
    },
    "A file open on your desktop has unsaved changes. Save or discard them there first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine auf deinem Desktop geöffnete Datei hat ungesicherte Änderungen. Sichere oder verwirf sie zuerst dort."
          }
        }
      }
    },
    "A new reasoning level applies from the next message. Change the rest on your desktop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Reasoning-Level gilt ab der nächsten Nachricht. Den Rest änderst du auf deinem Desktop."
          }
        }
      }
    },
    "AGENTS.md is read by every tool in this folder and usually shared with the team" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGENTS.md liest jedes Werkzeug in diesem Ordner; meist mit dem Team geteilt"
