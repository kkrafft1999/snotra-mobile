          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüssel stimmt nicht"
          }
        }
      }
    },
    "The app keeps trying. Snotra's relay may be down for a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App versucht es weiter. Snotras Relay ist vielleicht kurz nicht erreichbar."
