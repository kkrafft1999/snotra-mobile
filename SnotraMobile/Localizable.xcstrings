    },
    "The relay didn't accept this app" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay hat diese App nicht angenommen"
          }
        }
      }
    },
    "The relay refused the pairing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay hat das Koppeln abgelehnt"
          }
        }
      }
    },
    "The words you compare when pairing come from the EFF short word list 2.0, © 2016 Electronic Frontier Foundation, licensed under Creative Commons Attribution 3.0 United States (CC BY 3.0 US). The dice numbers were dropped; order and spelling are as published." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wörter, die du beim Koppeln vergleichst, stammen aus der EFF Short Word List 2.0, © 2016 Electronic Frontier Foundation, lizenziert unter Creative Commons Namensnennung 3.0 Vereinigte Staaten (CC BY 3.0 US). Die Würfelzahlen wurden entfernt; Reihenfolge und Schreibweise sind wie veröffentlicht."
          }
        }
      }
    },
    "This app speaks a newer version of the connection than Snotra on your desktop. Update Snotra there, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App spricht eine neuere Version der Verbindung als Snotra auf deinem Desktop. Aktualisiere Snotra dort und versuch es dann noch einmal."
          }
        }
      }
    },
    "This approval is no longer open" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Freigabe ist nicht mehr offen"
          }
        }
      }
    },
    "This chat has no messages yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat hat noch keine Nachrichten."
          }
        }
      }
    },
    "This chat no longer exists on your desktop, or its workspace is no longer open to your phone." : {
      "localizations" : {
