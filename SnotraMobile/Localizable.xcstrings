    },
    "Chats you start in this workspace on your desktop appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats, die du auf deinem Desktop in diesem Workspace beginnst, erscheinen hier."
          }
        }
      }
    },
    "Check that Snotra on your desktop shows the same six words, then choose Allow there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob Snotra auf deinem Desktop dieselben sechs Wörter zeigt, und wähle dort „Erlauben“."
          }
        }
      }
    },
    "Check your internet connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
