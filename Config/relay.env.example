# The production relay's configuration for release builds, read by
# scripts/testflight.sh. Keep the real file outside the repository, by default
# ~/env/snotra-mobile/relay.env, readable by you alone (chmod 600).

# The phone's own web API key in the Firebase project snotra-ai, "Snotra iOS
# relay", restricted to the Identity Toolkit API and the Firebase App Check API.
# The desktop's key does not allow App Check.
SNOTRA_RELAY_API_KEY = AIza...

# The iOS app's Firebase app ID, for the App Check exchange.
SNOTRA_FIREBASE_APP_ID = 1:123456789012:ios:0123456789abcdef
